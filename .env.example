# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — local SQLite file (no Docker required)
DATABASE_URL=file:./.data/toxichr.db

# Auth
AUTH_SECRET=replace-with-long-random-string

# AI — боевой режим: ChatGPT
# 1) Возьми ключ: https://platform.openai.com/api-keys
# 2) Вставь ниже в OPENAI_API_KEY
# 3) Перезапусти npm run dev
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Если OpenAI режет страну — укажи обходной адрес провайдера-посредника:
# OPENAI_BASE_URL=https://your-proxy.example/v1
# Запасной вариант вместо ChatGPT:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Storage
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Payments
# Пока PAYWALL_ENABLED не true — полный отчёт открыт всем (закрытый тест).
# Когда будешь брать деньги: PAYWALL_ENABLED=true + ключи Stripe.
PAYWALL_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ALLOW_MOCK_CHECKOUT=false
STRIPE_PRICE_FULL_REPORT=990
