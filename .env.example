# App
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Database — local SQLite file (no Docker required)
DATABASE_URL=file:./.data/toxichr.db

# Auth
AUTH_SECRET=replace-with-long-random-string
# Comma-separated emails allowed to open /ops/funnel
OPS_EMAILS=

# AI — боевой режим: ChatGPT
# 1) Возьми ключ: https://platform.openai.com/api-keys
# 2) Вставь ниже в OPENAI_API_KEY
# 3) Перезапусти npm run dev
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Если OpenAI режет страну — укажи обходной адрес провайдера-посредника:
# OPENAI_BASE_URL=https://your-proxy.example/v1
# Запасной вариант вместо ChatGPT:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Storage
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Beta monetization — disabled by default so local/dev E2E stays open.
# Enable only after production YooKassa credentials and webhook are configured.
BETA_PAYWALL_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Production webhook: https://<host>/api/payments/yookassa/webhook
