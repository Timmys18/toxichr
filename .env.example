# App
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Database — local SQLite file (no Docker required)
DATABASE_URL=file:./.data/toxichr.db

# Auth
AUTH_SECRET=replace-with-long-random-string
# Password reset email. Use a verified sender domain and keep the API key in protected environment settings.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_APP_URL=https://toxichr.ru
SUPPORT_EMAIL=
# Comma-separated emails allowed to open /ops/funnel
OPS_EMAILS=

# AI — OpenAI. Настоящий ключ задаётся в секретах окружения.
# Ключ хранить только в секретах окружения, не в Git.
AI_PROVIDER=openai

# OpenAI: профессиональный анализ и отдельный авторский взгляд выбранного HR.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ANALYST_MODEL=gpt-5.4-mini
OPENAI_WRITER_MODEL=gpt-6.1-sol
# Ошибочный ответ исправляет та же сильная модель, что его написала.
OPENAI_EDITOR_MODEL=gpt-6.1-sol
OPENAI_ANCHOR_MODEL=gpt-6.1-sol
AI_INDEPENDENT_PERSPECTIVE=true
AI_EDITORIAL_SELECTION=true
# Для согласованного OpenAI-разбора смысловая и финальная проверки обязательны.
# Отдельные модели для двух профессиональных этапов вакансии.
OPENAI_VACANCY_MODEL=gpt-5.4-mini
OPENAI_MATCH_MODEL=gpt-5.4-mini

# Storage
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Beta monetization — включите, чтобы проверить paywall на 199 ₽.
# Без YooKassa credentials checkout честно сообщит, что оплата ещё не настроена.
BETA_PAYWALL_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Production webhook: https://<host>/api/payments/yookassa/webhook
