generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PackageUsageKind {
  MATCH
  RECHECK
  IMPROVEMENT
  ADAPTATION
}

enum PackageUsageStatus {
  PENDING
  COMPLETED
}

model User {
  id                  String              @id @default(cuid())
  email               String?             @unique
  passwordHash        String?
  displayName         String?
  locale              String              @default("ru")
  consentVersion      String?
  marketingConsent    Boolean             @default(false)
  deletionRequestedAt DateTime?
  createdAt           DateTime            @default(now())
  lastLoginAt         DateTime?
  resumes             Resume[]
  analyses            Analysis[]
  shares              PublicShare[]
  payments            Payment[]
  grants              AccessGrant[]
  improvements        ResumeImprovement[]
  adaptations         ResumeAdaptation[]
  vacancies           Vacancy[]
  vacancyMatches      VacancyMatch[]
  packages            ToxicHrPackage[]
}

model ProductEvent {
  id         String   @id @default(cuid())
  eventName  String
  userId     String?
  visitorId  String?
  sessionId  String?
  properties Json?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
}

model Resume {
  id                     String          @id @default(cuid())
  userId                 String?
  user                   User?           @relation(fields: [userId], references: [id])
  originalFilename       String?
  mimeType               String?
  size                   Int?
  privateStorageKey      String?
  extractedTextEncrypted String?
  sanitizedText          String?
  language               String          @default("ru")
  status                 ResumeStatus    @default(UPLOADED)
  pageCount              Int?
  createdAt              DateTime        @default(now())
  deletedAt              DateTime?
  versions               ResumeVersion[]
  toxicHrPackage         ToxicHrPackage?
}

model ResumeVersion {
  id                String             @id @default(cuid())
  resumeId          String
  resume            Resume             @relation(fields: [resumeId], references: [id])
  parentVersionId   String?
  versionNumber     Int                @default(1)
  structuredContent Json?
  source            String             @default("upload")
  createdAt         DateTime           @default(now())
  candidateProfile  CandidateProfile?
  analyses          Analysis[]
  improvement       ResumeImprovement?
  adaptation        ResumeAdaptation?
}

model CandidateProfile {
  id                       String        @id @default(cuid())
  resumeVersionId          String        @unique
  resumeVersion            ResumeVersion @relation(fields: [resumeVersionId], references: [id])
  primaryRole              String?
  professionalFamily       String?
  claimedLevel             String?
  inferredLevel            String?
  industry                 String?
  experienceYears          Float?
  managementExperience     Boolean       @default(false)
  classificationConfidence Float?
}

model Persona {
  id                  String     @id @default(cuid())
  code                String     @unique
  name                String
  title               String
  description         String?
  visualAsset         String?
  systemPromptVersion String     @default("v1")
  active              Boolean    @default(true)
  analyses            Analysis[]
}

model Analysis {
  id              String              @id @default(cuid())
  resumeVersionId String
  resumeVersion   ResumeVersion       @relation(fields: [resumeVersionId], references: [id])
  personaId       String?
  persona         Persona?            @relation(fields: [personaId], references: [id])
  userId          String?
  user            User?               @relation(fields: [userId], references: [id])
  analysisType    String              @default("resume_review")
  modelProvider   String?
  modelName       String?
  schemaVersion   String              @default("v1")
  status          AnalysisStatus      @default(QUEUED)
  scorePayload    Json?
  reportPayload   Json?
  cost            Float?
  tokensIn        Int?
  tokensOut       Int?
  createdAt       DateTime            @default(now())
  shares          PublicShare[]
  feedback        AnalysisFeedback[]
  payments        Payment[]
  grants          AccessGrant[]
  improvements    ResumeImprovement[]
  adaptations     ResumeAdaptation[]
  rechecksForAdaptation ResumeAdaptation[] @relation("AdaptationRecheck")
  vacancyMatches  VacancyMatch[]
}

model ResumeImprovement {
  id              String         @id @default(cuid())
  analysisId      String         @unique
  analysis        Analysis       @relation(fields: [analysisId], references: [id])
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  resumeVersionId String?        @unique
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id])
  status          String         @default("questions")
  answers         Json?
  replacements    Json?
  improvedText    String?
  beforeScore     Int
  afterScore      Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, updatedAt])
}

model ResumeAdaptation {
  id                String         @id @default(cuid())
  analysisId        String
  analysis          Analysis       @relation(fields: [analysisId], references: [id])
  vacancyId         String
  vacancy           Vacancy        @relation(fields: [vacancyId], references: [id])
  userId            String?
  user              User?          @relation(fields: [userId], references: [id])
  resumeVersionId   String?        @unique
  resumeVersion     ResumeVersion? @relation(fields: [resumeVersionId], references: [id])
  recheckAnalysisId String?        @unique
  recheckAnalysis   Analysis?      @relation("AdaptationRecheck", fields: [recheckAnalysisId], references: [id])
  status            String         @default("questions")
  answers           Json?
  changes           Json?
  adaptedText       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([vacancyId, analysisId])
  @@index([userId, updatedAt])
}

model Vacancy {
  id         String         @id @default(cuid())
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  sourceText String
  title      String?
  company    String?
  review     Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  matches    VacancyMatch[]
  adaptations ResumeAdaptation[]

  @@index([userId, updatedAt])
}

model VacancyMatch {
  id                 String   @id @default(cuid())
  vacancyId          String
  vacancy            Vacancy  @relation(fields: [vacancyId], references: [id])
  analysisId         String
  analysis           Analysis @relation(fields: [analysisId], references: [id])
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  result             Json
  tailoredIntro      String?
  coverLetter        String?
  interviewQuestions Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([vacancyId, analysisId])
  @@index([userId, updatedAt])
}

model AnalysisFeedback {
  id           String   @id @default(cuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [id])
  annotationId String?
  verdict      String
  note         String?
  createdAt    DateTime @default(now())
}

model PublicShare {
  id            String            @id @default(cuid())
  analysisId    String?
  analysis      Analysis?         @relation(fields: [analysisId], references: [id])
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  slug          String            @unique
  publicPayload Json
  title         String?
  description   String?
  imageKey      String?
  active        Boolean           @default(true)
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  revokedAt     DateTime?
  events        ShareEvent[]
  referrals     ReferralSession[]
}

model ShareEvent {
  id            String      @id @default(cuid())
  publicShareId String
  publicShare   PublicShare @relation(fields: [publicShareId], references: [id])
  sessionId     String?
  eventType     String
  platform      String?
  metadata      Json?
  createdAt     DateTime    @default(now())
}

model ReferralSession {
  id                  String      @id @default(cuid())
  publicShareId       String
  publicShare         PublicShare @relation(fields: [publicShareId], references: [id])
  visitorId           String
  platform            String?
  campaign            String?
  startedResumeId     String?
  completedAnalysisId String?
  createdAt           DateTime    @default(now())
  completedAt         DateTime?

  @@index([visitorId])
  @@index([publicShareId])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  analysisId  String?
  analysis    Analysis?     @relation(fields: [analysisId], references: [id])
  provider    String        @default("manual")
  externalId  String?       @unique
  productCode String
  amount      Int
  currency    String        @default("usd")
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  paidAt      DateTime?
  grants      AccessGrant[]
  package     ToxicHrPackage?
}

model ToxicHrPackage {
  id          String         @id @default(cuid())
  resumeId    String         @unique
  resume      Resume         @relation(fields: [resumeId], references: [id])
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  paymentId   String?        @unique
  payment     Payment?       @relation(fields: [paymentId], references: [id])
  source      String         @default("payment")
  createdAt   DateTime       @default(now())
  usages      PackageUsage[]

  @@index([userId, createdAt])
}

model PackageUsage {
  id              String             @id @default(cuid())
  packageId       String
  package         ToxicHrPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  kind            PackageUsageKind
  status          PackageUsageStatus @default(PENDING)
  dedupeKey       String
  analysisId      String?
  vacancyId       String?
  resumeVersionId String?
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  @@unique([packageId, dedupeKey])
  @@index([packageId, kind, status])
  @@index([analysisId])
  @@index([vacancyId])
}

model AccessGrant {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id])
  productCode String
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  source      String   @default("payment")
  createdAt   DateTime @default(now())

  @@unique([analysisId, productCode])
  @@index([userId])
}
